---
import Layout from '../layouts/Layout.astro';
import ConverterApp from '../components/ConverterApp';
import { ModeToggle } from '../components/ModeToggle';
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
    <header class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">convertito</h1>
        <p class="mt-2 text-muted-foreground">
          Conversor de imágenes en tu navegador. Sin servidor, sin subidas, sin coste.
        </p>
      </div>
      <ModeToggle client:load />
    </header>

    <div class="mt-10">
      <ConverterApp client:only="react" />
    </div>

    <footer class="mt-16 border-t border-border pt-6 text-xs text-muted-foreground">
      <p>
        100% en tu navegador. Ningún archivo se sube. Las conversiones corren localmente
        con WebAssembly.
      </p>
      <p class="mt-1">
        Soporta JPEG, PNG, WebP, AVIF y JPEG XL · preserva EXIF e ICC.
      </p>
    </footer>
  </main>
</Layout>
