---
import Layout from '../layouts/Layout.astro';
import ConverterApp from '../components/ConverterApp';
import CategoryCard from '../components/CategoryCard.astro';
import PopularConversions from '../components/PopularConversions.astro';
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
    <section class="text-center">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Convierte y comprime <span class="text-primary">tus imágenes</span> en segundos
      </h1>
      <p class="mt-4 text-muted-foreground">
        Convertito transforma tus imágenes sin subir tus archivos a ningún servidor. Gratis, rápido y sin marcas de agua. Con control total y sin complicaciones.
      </p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm">
        <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1 text-muted-foreground">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            aria-hidden="true"
          >
            <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
          </svg>
          <span>Ultra rápido</span>
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1 text-muted-foreground">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            aria-hidden="true"
          >
            <path d="M18 21a8 8 0 0 0-16 0" />
            <circle cx="10" cy="8" r="5" />
            <path d="m17 3 5 5" />
            <path d="m22 3-5 5" />
          </svg>
          <span>Sin cuenta</span>
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3 py-1 text-muted-foreground">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
            aria-hidden="true"
          >
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <span>100% Privado</span>
        </li>
      </ul>
    </section>

    <div class="mt-10">
      <ConverterApp client:only="react" />
    </div>

    <section aria-labelledby="categories-heading" class="mt-14">
      <h2 id="categories-heading" class="text-lg font-semibold text-foreground">
        Categorías
      </h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Todo el catálogo en un solo lugar. Audio y documentos están de camino.
      </p>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <CategoryCard
          title="Imágenes"
          description="JPG, PNG, WebP, AVIF, JPEG XL — bidireccional."
          href="#"
          icon="image"
        />
        <CategoryCard
          title="Audio"
          description="MP3, FLAC, WAV, OGG y más, en tu navegador."
          icon="music"
          comingSoon
        />
        <CategoryCard
          title="Documentos"
          description="PDF, DOCX, ODT, RTF y formatos de oficina."
          icon="fileText"
          comingSoon
        />
      </div>
    </section>

    <PopularConversions />

    <footer class="mt-16 border-t border-border pt-6 text-xs text-muted-foreground">
      <p>
        100% en tu navegador. Ningún archivo se sube. Las conversiones corren localmente
        con WebAssembly.
      </p>
      <p class="mt-1">
        Soporta JPEG, PNG, WebP, AVIF y JPEG XL · preserva EXIF e ICC.
      </p>
    </footer>
  </main>
</Layout>
