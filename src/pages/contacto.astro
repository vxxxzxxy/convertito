---
import { FileInput, Goal, HeartHandshake, SearchCheck, Wrench } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import { ContactForm } from '../components/ContactForm';
import Footer from '../components/Footer.astro';

const reportItems = [
  {
    icon: FileInput,
    label: 'Qué archivo usaste',
    value: 'JPG, PNG, HEIC, TIFF, SVG u otro formato.',
  },
  {
    icon: Goal,
    label: 'Qué querías obtener',
    value: 'Formato de salida, calidad, tamaño o ajuste esperado.',
  },
  {
    icon: SearchCheck,
    label: 'Qué ocurrió',
    value: 'Error, descarga vacía, resultado raro o lentitud.',
  },
];
---

<Layout
  title="Contacto · convertito"
  description="Reporta problemas, formatos que fallan o sugerencias para mejorar Convertito."
>
  <main class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
    <section class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Cuéntanos qué podemos <span class="text-primary">mejorar</span>
      </h1>
      <p class="mt-4 text-muted-foreground">
        Si algo no funciona, falta un formato o tienes una idea útil, cuéntanoslo. Los reportes ayudan a priorizar lo que más importa.
      </p>
    </section>

    <section class="mt-12 grid gap-6 lg:grid-cols-[0.85fr_1.55fr]">
      <div class="space-y-6">
        <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
          <h2 class="text-lg font-semibold text-foreground">Antes de enviar</h2>
          <dl class="mt-5 space-y-4">
            {
              reportItems.map(({ icon: Icon, label, value }) => (
                <div class="flex gap-3">
                  <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <Icon className="size-4" aria-hidden="true" />
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{label}</dt>
                    <dd class="mt-1 text-sm font-medium text-foreground">{value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </article>

        <article class="rounded-lg bg-foreground p-5 text-background shadow-sm dark:bg-card dark:text-foreground dark:ring-1 dark:ring-border">
          <div class="flex size-9 items-center justify-center rounded-lg bg-background/10 text-background dark:bg-primary/10 dark:text-primary">
            <HeartHandshake className="size-4" aria-hidden="true" />
          </div>
          <h2 class="mt-4 text-base font-semibold">Reportes que ayudan</h2>
          <p class="mt-3 text-sm text-background/70 dark:text-muted-foreground">
            No necesitas escribir perfecto. Con el formato original, el navegador y una breve descripción suele bastar para investigar el problema.
          </p>
          <a href="/image" class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-primary">
            Volver a herramientas
            <Wrench className="size-4" aria-hidden="true" />
          </a>
        </article>
      </div>

      <ContactForm client:load />
    </section>

    <Footer />
  </main>
</Layout>
